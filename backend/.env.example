# Server
PORT=4000
# Runtime mode: development | test | production. Required in production; local default is development.
NODE_ENV=development
# Version reported by GET /health. Not a secret; optional in production (schema default 0.1.0).
VERSION=0.1.0

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Rate limiting (public endpoints: /health, /soroban/config)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Soroban / Stellar
SOROBAN_NETWORK=testnet
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
SOROBAN_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Optional: contract id for the deployed Shelterflex contract
SOROBAN_CONTRACT_ID=

# Soroban contract IDs (set after deploying contracts)
SOROBAN_USDC_TOKEN_ID=
SOROBAN_STAKING_POOL_ID=
SOROBAN_STAKING_REWARDS_ID=
SOROBAN_TIMELOCK_ID=
SOROBAN_DEAL_ESCROW_ID=
SOROBAN_RENT_PAYMENTS_ID=
SOROBAN_REWARD_DISTRIBUTION_ID=
SOROBAN_WHISTLEBLOWER_VALIDATION_ID=
# multisig_admin contract (#1972). When set, covered admin operations (circuit-breaker drain,
# contract-access role assignment) become multisig proposals instead of executing directly. The
# platform key (SOROBAN_ADMIN_SECRET) must be one of the contract's signers.
MULTISIG_ADMIN_ID=

# Secret key used to sign Soroban transactions (e.g., your operator identity)
SOROBAN_ADMIN_SECRET=
# Enables admin signing for privileged Soroban operations. Optional in production;
# keep false locally unless an admin signing key is configured.
SOROBAN_ADMIN_SIGNING_ENABLED=false

# USDC token contract address (required in non-development environments)
# Testnet example: USDC_TOKEN_ADDRESS=0x8d3e2a4e2c3b4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9
# Mainnet example: USDC_TOKEN_ADDRESS=0xa0b86a33e6c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c4c
USDC_TOKEN_ADDRESS=

# Custodial wallet master keys (envelope encryption KEKs)
# REQUIRED for production: Base64-encoded 32-byte AES-256 key for encrypting wallet secret keys
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# SECURITY: Never commit actual keys to git. This is used for AES-256-GCM encryption at rest.
CUSTODIAL_WALLET_MASTER_KEY_V1=
CUSTODIAL_WALLET_MASTER_KEY_V2=
# Active version for new wallets and rotation target (1 or 2)
CUSTODIAL_WALLET_MASTER_KEY_ACTIVE_VERSION=1

# Custodial mode configuration
CUSTODIAL_MODE_ENABLED=true
CUSTODIAL_SIGNING_PAUSED=false

# Indexer configuration
INDEXER_POLL_MS=5000
INDEXER_START_LEDGER=


DATABASE_URL=postgres://app:app@localhost:5432/app
# Auth store backend: "postgres" or "memory". Default: postgres when DATABASE_URL is set,
# memory when it is not. A database error is never answered from an in-memory copy;
# with postgres it surfaces as a 503.
# AUTH_STORE=postgres
# Dev only: log the (masked) body of console-provider notifications at debug level.
# Needs LOG_LEVEL=debug to be visible and is ignored in production.
# NOTIFICATION_DEV_PRINT=false
# AES-256 key (at least 32 characters) used to encrypt stored wallet secrets.
# Required in production with a real generated key; this placeholder is for local dev only.
ENCRYPTION_KEY=replace-with-a-32-character-local-dev-key

# Inbound webhook anti-replay window. Providers must sign
# "<x-webhook-timestamp>.<raw request body>". Default: 300 seconds.
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300

# Validates INBOUND provider webhooks (Paystack/Flutterwave signature checks). Required in production.
WEBHOOK_SECRET=
# Enforces signature checks on inbound webhooks outside production too. Optional in production
# (enforced unconditionally there); leave false locally unless you configure the secrets below.
WEBHOOK_SIGNATURE_ENABLED=false

# Provider webhook signing secrets. Leave blank locally; all three are required in production.
PAYSTACK_SECRET=
FLUTTERWAVE_SECRET=
# Guards legacy shared-secret admin routes. Required in production; leave blank locally.
MANUAL_ADMIN_SECRET=

# NOT the same as WEBHOOK_SECRET above. Used by webhookVerifier.ts (verifyWithRotation) as the
# HMAC key for a separate outbound/rotation webhook signing path. Required in all environments.
# Use a local placeholder here; set a real key in production.
WEBHOOK_KEY=replace-with-local-webhook-key
# Optional previous-generation value of WEBHOOK_KEY, checked as a fallback during key rotation.
WEBHOOK_OLD_KEY=

# Required in production. Presence-only flag checked at startup; no other code in the codebase
# reads its value, so its intended purpose beyond gating startup is undocumented — confirm with
# whoever introduced it before relying on it for anything more than "is this set".
SECURE_CONFIG=

# NGN → USDC conversion (deposits / staking on-ramp)
FX_RATE_NGN_PER_USDC=1600
# stub | http | fallback
CONVERSION_PROVIDER=stub
CONVERSION_RATE_URL=
CONVERSION_RATE_API_KEY=
CONVERSION_HTTP_TIMEOUT_MS=10000
CONVERSION_RATE_MIN=1
CONVERSION_RATE_MAX=50000

# Quote limits (staking / savings on-ramp)
# Maximum NGN amount accepted by a quote. Optional in production (schema default 5_000_000).
QUOTE_MAX_AMOUNT_NGN=5000000
# How long a quote stays valid, in milliseconds. Optional in production (schema default 300000).
QUOTE_EXPIRY_MS=300000
# Fee and slippage fractions (0-1) applied to quotes. Optional in production.
QUOTE_FEE_PERCENT=0.015
QUOTE_SLIPPAGE_PERCENT=0.005

# Redis connection used for shared caching/limiting. Optional in production;
# the local default points at a development Redis instance.
REDIS_URL=redis://localhost:6379

# Secret Rotation Configuration
# Secrets are automatically hot-reloaded when environment variables change
# Grace period allows old secrets to remain valid during rotation
# Default grace period: 5 minutes for most secrets, 15 minutes for encryption keys
# Audit logs are written to ./logs/secret-rotation-audit.log
AUDIT_LOG_DIR=./logs

# OTP Delivery (Resend)
# REQUIRED when OTP_DELIVERY_PROVIDER=email
OTP_DELIVERY_PROVIDER=console
RESEND_API_KEY=
RESEND_FROM_EMAIL=otp@yourdomain.com

# Metrics & Monitoring
# Prometheus exporter port for metrics scraping
PROMETHEUS_PORT=9464
METRICS_TOKEN=replace-with-secure-random-token

# OpenTelemetry configuration
OTEL_SERVICE_NAME=shelterflex-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SAMPLING_RATIO=1.0
# Optional: Custom headers for OTLP exporter (format: key=value,key2=value2)
OTEL_EXPORTER_OTLP_HEADERS=

# Object Storage Configuration
# Storage provider: s3 (AWS S3 or MinIO) or local (filesystem)
STORAGE_PROVIDER=s3
# S3 Configuration (required when STORAGE_PROVIDER=s3)
S3_BUCKET=tenant-documents
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=  # For MinIO: http://localhost:9000
S3_FORCE_PATH_STYLE=true  # Set to true for MinIO
# Local Storage Configuration (required when STORAGE_PROVIDER=local)
LOCAL_STORAGE_DIR=/tmp/shelterflex-dev

# Full-payment incentive payout split (NGN)
# Split version recorded with each payout. Optional in production (schema default v1).
FULL_PAYMENT_SPLIT_VERSION=v1
# Platform and reporter fractions (0-1, combined <= 1). Both default to 0 locally;
# set deliberately in production rather than copying these zeros.
FULL_PAYMENT_PLATFORM_SHARE=0
FULL_PAYMENT_REPORTER_SHARE=0
